# Copy this file to ".env" (Docker Compose loads it automatically) and adjust.
#   cp .env.example .env
#
# Generate a strong JWT secret, e.g.:
#   openssl rand -base64 48
#   (or in PowerShell)  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))

# REQUIRED — the HMAC secret all services use to sign/verify JWTs.
# Must be long and random. The stack refuses to start if this is empty.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Passwords for the per-service Postgres databases.
USER_DB_PASSWORD=aura_dev
PRODUCT_DB_PASSWORD=aura_dev
ORDER_DB_PASSWORD=aura_dev
PAYMENT_DB_PASSWORD=aura_dev

# Log level for the Go services: debug | info | warn | error
LOG_LEVEL=info

# CORS allowed origin for the API. "*" is fine for local dev; in production set
# this to your storefront's URL, e.g. https://shop.example.com
ALLOWED_ORIGIN=*
